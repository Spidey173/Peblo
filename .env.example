# Security
SECRET_KEY=super-secret-key-change-me-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL + pgvector
# Pooled connection string for runtime (e.g. Neon -pooler or Supabase PgBouncer port 6543)
DATABASE_URL=postgresql+psycopg://peblo:peblo@localhost:5432/peblo
# Direct (unpooled) connection string for Alembic migrations
DIRECT_URL=postgresql+psycopg://peblo:peblo@localhost:5432/peblo

# AI Providers
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

